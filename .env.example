# Copy to .env to enable the real LLM path. The orchestrator runs fully offline
# without this — a deterministic heuristic planner/verifier/synthesizer stand in
# for the model so every pillar is testable with no API key.
ANTHROPIC_API_KEY=

# Optional overrides
ORCHESTRATOR_MODEL=claude-sonnet-5
ORCHESTRATOR_MAX_STEPS=12
ORCHESTRATOR_MAX_REPLANS=3
ORCHESTRATOR_MAX_COST_USD=0.50
